MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=CodexBot
MC_AUTH=offline

MC_VERSION=1.21.4

# Optional bounded "This is gonna be great!!!" survival demo overrides.
SURVIVAL_DEMO_LOG_PATH=/absolute/path/to/server/logs/latest.log
SURVIVAL_DEMO_STATE_DIRECTORY=/absolute/path/to/runtime/survival-demo-state
SURVIVAL_DEMO_CLEARING_X=52.5
SURVIVAL_DEMO_CLEARING_Y=66
SURVIVAL_DEMO_CLEARING_Z=48.5

SHOWRUNNER_HERO_USERNAME=HeroActor
SHOWRUNNER_RIVAL_USERNAME=RivalActor
SHOWRUNNER_CONTROLLER_NAME=ProductionController
SHOWRUNNER_ARTIFACT_DIR=/absolute/path/to/Minecraft/artifacts
SHOWRUNNER_RECORDING_DIR=/absolute/path/to/Minecraft/recordings
# Keep the private Ed25519 key available only to the offline rehearsal/approval process.
SHOWRUNNER_APPROVAL_PRIVATE_KEY=
# Runtime and actor processes receive only the matching public Ed25519 key.
SHOWRUNNER_APPROVAL_PUBLIC_KEY=
