{
  "name": "minecraft-live-experiments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Minecraft Java live experimentation harness using a Mineflayer bot.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "bot": "env MC_VERSION=${MC_VERSION:-1.21.4} /opt/homebrew/opt/node@22/bin/node src/bot.mjs",
    "generate-flamefrags-base": "node scripts/generate-flamefrags-base.mjs",
    "install-meadow-set": "node scripts/install-first-day-meadow-set.mjs",
    "meadow-live": "env MC_VERSION=${MC_VERSION:-1.21.4} /opt/homebrew/opt/node@22/bin/node src/showrunner/live-meadow-cli.mjs",
    "llm-agent": "env MC_VERSION=${MC_VERSION:-1.21.4} /opt/homebrew/opt/node@22/bin/node src/llm-agent/cli.mjs",
    "llm-agent:verify-live": "node scripts/verify-llm-agent-live.mjs",
    "llm-pipeline:verify-live": "node scripts/verify-llm-goal-pipeline-live.mjs --phase completed",
    "survival-demo": "env MC_VERSION=${MC_VERSION:-1.21.4} /opt/homebrew/opt/node@22/bin/node src/llm-agent/survival-demo-cli.mjs",
    "download-server": "node scripts/download-server.mjs",
    "server": "cd server && ${JAVA_BIN:-/opt/homebrew/opt/openjdk/bin/java} -Xmx2G -Xms1G -jar server.jar nogui",
    "movie-war": "env MC_VERSION=${MC_VERSION:-1.21.4} /opt/homebrew/opt/node@22/bin/node src/movie-war.mjs",
    "movie-war-fight": "env MOVIE_WAR_MODE=fight MC_VERSION=${MC_VERSION:-1.21.4} /opt/homebrew/opt/node@22/bin/node src/movie-war.mjs",
    "showrunner": "node src/showrunner/cli.mjs",
    "showrunner:rehearse": "node src/showrunner/cli.mjs rehearse",
    "showrunner:security-check": "node src/showrunner/cli.mjs security-check"
  },
  "dependencies": {
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.1.10",
    "yaml": "^2.9.0"
  }
}
